{
  "expo": {
    "name": "macromate",
    "slug": "macromate",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "macromate",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.macromate",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "MacroMate uses speech recognition to turn your meal description into text.",
        "NSMicrophoneUsageDescription": "MacroMate needs microphone access so you can describe meals by voice."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundImage": "./assets/icon-background.png",
        "backgroundColor": "#0B1120"
      },
      "package": "com.macromate",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "runtimeVersion": "1.0.0"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MacroMate needs microphone access so you can describe meals by voice.",
          "speechRecognitionPermission": "MacroMate uses speech recognition to turn your meal description into text."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "student-661",
          "project": "macromate-frontend"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "675679a2-e3df-4f45-bd97-aaf53b585072"
      }
    },
    "owner": "srnanvare007",
    "updates": {
      "url": "https://u.expo.dev/675679a2-e3df-4f45-bd97-aaf53b585072"
    }
  }
}
