# Copy to .env and fill in your values:
#   cp .env.example .env
#
# Expo inlines EXPO_PUBLIC_* variables at bundle time — restart Metro after changes.

EXPO_PUBLIC_API_BASE_URL=https://macromate-backend-ceuyidt2iq-uc.a.run.app
EXPO_PUBLIC_API_KEY=your-api-key-here

# Sentry source-map / debug-symbol upload (build-time only — NOT bundled into the app).
# Create at: https://student-661.sentry.io → Settings → Auth Tokens (scope: project:releases).
# Locally: put the real value in .env (gitignored). For EAS: add as an EAS env var (sensitive).
SENTRY_AUTH_TOKEN=your-sentry-auth-token
